# server/.env로 복사해 값을 채운다. server/.env는 커밋하지 않는다.

# 외부 API 키
SEOUL_REALTIME_API_KEY=
KAKAO_REST_API_KEY=

# 외부 API 일일 호출 한도
SEOUL_REALTIME_DAILY_LIMIT=1000
KAKAO_ROUTE_DAILY_LIMIT=1000
KAKAO_KEYWORD_DAILY_LIMIT=100000
KAKAO_COORD2ADDRESS_DAILY_LIMIT=10000

# 기타
RATE_LIMIT_PER_MINUTE=60
MOCK_UPSTREAM=false
STATIONS_DB_PATH=data/stations.sqlite
FIXTURES_DIR=tests/fixtures
UPSTREAM_TIMEOUT_SEC=5.0
UPSTREAM_RETRY_DELAY_SEC=0.5
