# server/.env로 복사해 값을 채운다. server/.env는 커밋하지 않는다.

# 외부 API 키
SEOUL_REALTIME_API_KEY=
# 일반 인증키(시간표)
SEOUL_OPENAPI_KEY=

# 외부 API 일일 호출 한도(0 = 제한 없음. 서울시 키는 2026-11-15부터 한도가 없다)
SEOUL_REALTIME_DAILY_LIMIT=0
SEOUL_TIMETABLE_DAILY_LIMIT=0

# /v1/metrics를 볼 때 X-Metrics-Token 헤더로 보내는 값(비우면 지표가 닫힌다)
METRICS_TOKEN=
# 실측 결과물·운행표를 받는 주소(기본: 저장소 릴리스 measured-timetable). 비우면 쓰지 않는다
# MEASURED_BASE_URL=

# 기타
RATE_LIMIT_PER_MINUTE=60
MOCK_UPSTREAM=false
STATIONS_DB_PATH=data/stations.sqlite
FIXTURES_DIR=tests/fixtures
UPSTREAM_TIMEOUT_SEC=5.0
UPSTREAM_RETRY_DELAY_SEC=0.5
